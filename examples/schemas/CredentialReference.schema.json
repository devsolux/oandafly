{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "account_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Account Ids",
      "type": "array"
    },
    "authority_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Authority Id",
      "type": "string"
    },
    "credential_id": {
      "format": "uuid",
      "title": "Credential Id",
      "type": "string"
    },
    "entitlement_evidence_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entitlement Evidence Sha256"
    },
    "environment": {
      "enum": [
        "LIVE",
        "SANDBOX"
      ],
      "title": "Environment",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "purpose": {
      "enum": [
        "V20_OBSERVATION",
        "V20_EXECUTION",
        "RATES_OBSERVATION"
      ],
      "title": "Purpose",
      "type": "string"
    }
  },
  "required": [
    "credential_id",
    "authority_id",
    "environment",
    "purpose",
    "expires_at"
  ],
  "title": "CredentialReference",
  "type": "object"
}
